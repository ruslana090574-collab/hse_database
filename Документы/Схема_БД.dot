digraph DB {
graph [rankdir=LR, bgcolor="white", nodesep=0.4, ranksep=0.7, pad=0.3];
node [shape=plain,fontname="DejaVu Sans",fontsize=10];
edge [fontname="DejaVu Sans",fontsize=9,color="#56718c",arrowsize=0.8];
"Gender" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Gender / Пол</B></FONT></TD></TR><TR><TD ALIGN="LEFT">GenderCode — Код пола</TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT">GenderName — Наименование пола</TD><TD ALIGN="LEFT">VARCHAR(7)</TD></TR><TR><TD ALIGN="LEFT">GenderSymbol — Обозначение</TD><TD ALIGN="LEFT">CHAR(1)</TD></TR></TABLE>>];
"Currency" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Currency / Справочник валют</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CurrencyCode — Код валюты</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">AlphaCode — Буквенный код</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">CurrencyName — Наименование валюты</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR></TABLE>>];
"ExchangeRate" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>ExchangeRate / Курс валюты</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CurrencyCode — Код валюты</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">RateDate — Дата курса</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">Rate — Курс</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR></TABLE>>];
"Currency" -> "ExchangeRate" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"Country" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Country / Справочник стран</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CountryCode — Код ОКСМ</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">CountryName — Наименование страны</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">CurrencyCode — Код валюты</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">Coverage — Страховое покрытие</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">Factor — Коэффициент</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR></TABLE>>];
"Currency" -> "Country" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"ServiceCategory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>ServiceCategory / Справочник категорий услуг</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CategoryCode — Код категории</TD><TD ALIGN="LEFT">CHAR(2)</TD></TR><TR><TD ALIGN="LEFT">CategoryName — Наименование категории</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR></TABLE>>];
"Service" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Service / Услуга</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ServiceCode — Код услуги</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">CategoryCode — Код категории</TD><TD ALIGN="LEFT">CHAR(2)</TD></TR><TR><TD ALIGN="LEFT">ServiceName — Наименование услуги</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR></TABLE>>];
"ServiceCategory" -> "Service" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"ServicePrice" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>ServicePrice / Стоимость услуг</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ServiceCode — Код услуги</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">PriceDate — Дата стоимости</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">BasePrice — Базовая стоимость</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR></TABLE>>];
"Service" -> "ServicePrice" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"Client" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Client / Клиент</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PassportNo — Номер паспорта</TD><TD ALIGN="LEFT">CHAR(9)</TD></TR><TR><TD ALIGN="LEFT">FullName — ФИО клиента</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">BirthDate — Дата рождения</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">GenderCode — Код пола</TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD ALIGN="LEFT">IssueDate — Дата выдачи</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">ExpiryDate — Действителен до</TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
"Gender" -> "Client" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"Agent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Agent / Страховой агент</B></FONT></TD></TR><TR><TD ALIGN="LEFT">AgentID — Код агента</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">AgentName — ФИО агента</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">AgentPassport — Паспорт агента</TD><TD ALIGN="LEFT">CHAR(10)</TD></TR><TR><TD ALIGN="LEFT">IssueDate — Дата выдачи</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">Issuer — Кем выдан</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">IsActive — Активен</TD><TD ALIGN="LEFT">SMALLINT</TD></TR></TABLE>>];
"AgentContract" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>AgentContract / Договор агента</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ContractNo — Номер договора</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">AgentID — Код агента</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">ContractDate — Дата договора</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">ContractStart — Начало договора</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">ContractEnd — Окончание договора</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">CommissionPct — Процент комиссии</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR><TR><TD ALIGN="LEFT">BankBIK — БИК</TD><TD ALIGN="LEFT">CHAR(9)</TD></TR><TR><TD ALIGN="LEFT">BankAccount — Счёт</TD><TD ALIGN="LEFT">CHAR(20)</TD></TR><TR><TD ALIGN="LEFT">BankName — Наименование банка</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR></TABLE>>];
"Agent" -> "AgentContract" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"Policy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>Policy / Страховой полис</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PolicyID — Номер полиса</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">PassportNo — Номер паспорта</TD><TD ALIGN="LEFT">CHAR(9)</TD></TR><TR><TD ALIGN="LEFT">IssuedOn — Дата оформления</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">StartsOn — Начало действия</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">EndsOn — Окончание действия</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">CountryCode — Код ОКСМ</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">ContractNo — Номер договора</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">PolicyFactor — Коэффициент полиса</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR><TR><TD ALIGN="LEFT">PolicyCoverage — Покрытие полиса</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">PolicyCurrency — Валюта полиса</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">PolicyRate — Курс полиса</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR><TR><TD ALIGN="LEFT">RateDate — Дата курса</TD><TD ALIGN="LEFT">DATE</TD></TR></TABLE>>];
"Client" -> "Policy" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"Country" -> "Policy" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"AgentContract" -> "Policy" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"ExchangeRate" -> "Policy" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"PolicyService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#17365d"><FONT COLOR="white"><B>PolicyService / Услуги в полисе клиента</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PolicyID — Номер полиса</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">ServiceCode — Код услуги</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">TariffDate — Дата тарифа</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">AgreedPrice — Цена услуги</TD><TD ALIGN="LEFT">DECIMAL(12,2)</TD></TR></TABLE>>];
"Policy" -> "PolicyService" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
"ServicePrice" -> "PolicyService" [arrowhead=crow,arrowtail=tee,dir=both,label="1 : N"];
}